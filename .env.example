DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
FRONTEND_URL=https://oricalcum.vercel.app,http://localhost:3000
API_PREFIX=/api/v1

# AI assistant (Gemini agent + MCP)
GOOGLE_API_KEY=your_google_generative_ai_key_here
AGENT_MODEL=gemini-2.5-flash
# Loopback URL the agent uses to reach the in-process FastMCP server.
# Must match host:port the server runs on + the /mcp/ mount path.
MCP_INTERNAL_URL=http://127.0.0.1:8000/mcp/
